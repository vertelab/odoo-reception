<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="module_category_human_resources_reception" model="ir.module.category">
    <field name="name">Reception</field>
    <field name="sequence">20</field>
    <field name="parent_id" ref="base.module_category_human_resources"/>
</record>

    
    
    <record id="reception_group_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="base.module_category_human_resources_reception"/>
    </record>

    <record id="reception_group_administrator" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="base.module_category_human_resources_reception"/>
        <field name="implied_ids" eval="[(4, ref('visitor_management.reception_group_user'))]"/>

    </record>

    <record id="base.default_user" model="res.users">
        <field name="groups_id" eval="[(4, ref('visitor_management.reception_group_administrator'))]"/>
    </record>

    <record id="reception_reception_company_rule" model="ir.rule">
        <field name="name">Access stations of own companies only</field>
        <field name="model_id" ref="model_reception_reception"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="reception_visitor_company_rule" model="ir.rule">
        <field name="name">Access visitors of own companies only</field>
        <field name="model_id" ref="model_reception_visitor"/>
        <field name="domain_force">[('station_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="reception_reception_user_rule" model="ir.rule">
        <field name="name">User Group Reception Reception Model</field>
        <field name="model_id" ref="model_reception_reception"/>
        <field name="groups" eval="[(4, ref('visitor_management.reception_group_user'))]"/>
        <field name="domain_force">[('responsible_ids', 'in', user.id)]</field>
    </record>

    <record id="reception_visitor_user_rule" model="ir.rule">
        <field name="name">User Group Reception Visitor Model</field>
        <field name="model_id" ref="model_reception_visitor"/>
        <field name="groups" eval="[(4, ref('visitor_management.reception_group_user'))]"/>
        <field name="domain_force">[('station_id.responsible_ids', 'in', user.id)]</field>
    </record>

    <record id="reception_reception_administrator_rule" model="ir.rule">
        <field name="name">Allow to create or edit all stations</field>
        <field name="model_id" ref="model_reception_reception"/>
        <field name="groups" eval="[(4, ref('visitor_management.reception_group_administrator'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="reception_visitor_administrator_rule" model="ir.rule">
        <field name="name">Allow to create or edit all visitors</field>
        <field name="model_id" ref="model_reception_visitor"/>
        <field name="groups" eval="[(4, ref('visitor_management.reception_group_administrator'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
