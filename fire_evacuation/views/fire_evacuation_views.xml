<odoo>
    <data>
        <record id="fire_evacuation_view_list" model="ir.ui.view">
            <field name="name">fire.evacuation.view.list</field>
            <field name="model">fire.evacuation</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="date"/>
                </list>
            </field>
        </record>

        <record id="fire_evacuation_view_form" model="ir.ui.view">
            <field name="name">fire.evacuation.view.form</field>
            <field name="model">fire.evacuation</field>
            <field name="arch" type="xml">
                <form>
                    <header>

                    </header>
                    <sheet>
<!--                        <field name="active" invisible="1"/>-->
<!--                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>-->
                        <group>
                            <group>
                                <field name="name" placeholder="Site"/>
                            </group>
                            <group>
                                <field name="date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Evacuation List">
                                <field name="fire_evacuation_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="phone"/>
                                        <field name="resource_ref"/>
                                        <field name="is_ok"/>
                                        <field name="fire_evacuation_id" column_invisible="1"/>
                                    </list>
                                </field>

                            </page>
                        </notebook>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_fire_evacution" model="ir.actions.act_window">
            <field name="name">Fire Evacuation</field>
            <field name="res_model">fire.evacuation</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
            id="evacuation_menu"
            name="Evacuation"
            parent="visitor_management.reception_menu_root"
            action="action_fire_evacution"
            sequence="4"/>

    </data>
</odoo>